{
  "expo": {
    "name": "VoiceGuard",
    "slug": "voiceguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "voiceguard",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.voiceguard.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone to hear the call on speaker.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to turn speech into text on this phone."
      }
    },
    "android": {
      "package": "com.voiceguard.app",
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone to hear the call on speaker.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to turn speech into text on this phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "711f558c-83a0-480c-92df-ae87df60e62b"
      }
    }
  }
}
